# Copy to .env.local and fill in from the Supabase dashboard
# (Project Settings -> API Keys). Never commit real values.

# Public: safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret: bypasses RLS. Server-only (never NEXT_PUBLIC_). The app uses it for
# system steps only: invitation sign-in, provider webhooks and attaching payment
# orders (decisions D-008, D-012). scripts/bootstrap.ts and the tests use it too.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Sandbox payment and e-signature providers for development and tests (D-013).
# NEVER enable in production: they let a signed-in client simulate payments.
# Also requires an enabled "sandbox" integration account for the organization.
# Generate the secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENABLE_SANDBOX_PROVIDERS=true
# SANDBOX_WEBHOOK_SECRET=

# Razorpay (when the merchant account is approved). Webhook URL:
#   https://<site>/api/webhooks/payments/razorpay
# Also enable it under Billing -> Providers with your Razorpay account ID.
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# PAYMENTS_PROVIDER=razorpay   # optional override: razorpay | sandbox
# ESIGN_PROVIDER=sandbox       # until an e-signature vendor is approved
# SCHEDULING_PROVIDER=disabled # simulate a scheduler outage (callback fallback)

# Optional: password for the throwaway RLS fixture users (dev project only).
# TEST_USER_PASSWORD=

# Atmors AI (D-021). Default is the offline "local" provider: no prompts leave
# the system. To use Claude: AI_PROVIDER=anthropic and ANTHROPIC_API_KEY.
# AI_PROVIDER=local            # local | anthropic | disabled
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=low                # low | medium | high | xhigh | max
# AI_FALLBACKS=on              # server-side refusal fallback; "off" to disable
# AI_TIMEOUT_MS=30000
# AI_ORG_DAILY_TOKENS=500000
# AI_ACTOR_DAILY_MESSAGES=40

# Notifications (D-024). Without these, emails are logged instead of sent.
# RESEND_API_KEY=
# EMAIL_FROM=Atmors <hello@your-domain>

# Scheduled jobs (D-025): Vercel Cron sends "Authorization: Bearer $CRON_SECRET".
# CRON_SECRET=

# Staff MFA (D-027). Set to true in staging and production.
# REQUIRE_STAFF_MFA=true
