# Copy to .env.local and fill in from the Supabase dashboard
# (Project Settings -> API Keys). Never commit real values.

# Public: safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret: bypasses RLS. Used only by scripts/bootstrap.ts and the security tests,
# never by the running app. Keep it out of Vercel unless a server feature needs it.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Optional: password for the throwaway RLS fixture users (dev project only).
# TEST_USER_PASSWORD=
